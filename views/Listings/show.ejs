<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Details</title>
</head>
<body>
    <h3>Listing Details: </h3>
    <ul>
        <li>
            <%= Listing.title %>
        </li>
        <li>
            <%= Listing.description %>
        </li>
        <li>
           &#8377; <%= Listing.price.toLocaleString("en-IN") %>
        </li>
        <li>
            <%= Listing.location %>
        </li>
        <li>
            <%= Listing.country %>
        </li>
        
    </ul>

    <br>
  
  <a href="/Listings/<%= Listing.id %>/edit">Edit this List</a>
<br><br>
  <form method="POST" action="/Listings/<%= Listing.id %>?_method=DELETE">
    <button>Delete this listing</button>
</form>
</body>
</html>